{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-dictation.invalid/schema/cleanup-training-record-v2.json",
  "title": "Cleanup training authoring record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "raw", "expected", "categories", "must_preserve", "must_remove",
    "risk_tags", "source", "family_id", "template_id", "split", "review",
    "license", "generator_version"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "raw": {"type": "string", "minLength": 1},
    "expected": {"type": "string", "minLength": 1},
    "spoken": {"type": "string", "minLength": 1},
    "categories": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["no_op", "already_clean", "punctuation", "capitalization", "self_correction", "false_start", "fillers", "discourse_marker", "repetition", "abandoned_start", "mixed", "grammar_rewrite", "asr_correction", "lexical_addition", "must_not_answer", "adversarial_instruction", "question", "command", "formatting_directive", "spoken_punctuation", "list_formatting", "paragraph_formatting", "conversational_tone", "names", "numbers", "dates", "money", "versions", "paths", "identifiers", "facts", "technical_text", "unicode", "multilingual", "negation", "uncertainty", "high_stakes", "long_form", "multi_sentence"]}
    },
    "must_preserve": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "must_remove": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "risk_tags": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["negation", "number", "name", "uncertainty", "technical_literal", "dictated_instruction", "formatting_scope", "superseded_fact", "adversarial_content", "unicode_literal", "ambiguous_preserve", "private_data", "lexical_addition", "inferred_content", "high_stakes"]}
    },
    "allowed_additions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source": {"enum": ["human_authored", "template_human_reviewed", "deterministic_generated", "llm_proposed_human_approved", "consented_real_stt", "public_corpus"]},
    "source_ref": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "template_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "dev", "blind", "real_canary"]},
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewers"],
      "properties": {
        "status": {"enum": ["draft", "pending", "approved", "rejected"]},
        "reviewers": {"type": "integer", "minimum": 0},
        "adjudicated": {"type": "boolean"},
        "reviewed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "reviewer_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "license": {"type": "string", "minLength": 1},
    "generator_version": {"type": "string", "minLength": 1},
    "speaker_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "notes": {"type": "string", "minLength": 1}
  }
}
