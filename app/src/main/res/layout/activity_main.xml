<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/benchmark_title"
            android:textColor="@color/local_flow_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/benchmark_subtitle"
            android:textColor="@color/local_flow_muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/local_flow_surface"
            android:padding="12dp"
            android:text="@string/integration_warning"
            android:textColor="@color/local_flow_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/local_flow_surface"
            android:padding="16dp"
            android:text="@string/status_model_not_loaded"
            android:textColor="@color/local_flow_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/loadModelButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/load_model" />

        <Button
            android:id="@+id/dictationButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/start_dictation"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/raw_transcript"
            android:textColor="@color/local_flow_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/transcriptText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/local_flow_surface"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="160dp"
            android:padding="16dp"
            android:hint="@string/transcript_placeholder"
            android:textColor="@color/local_flow_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/cleanup_benchmark"
            android:textColor="@color/local_flow_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cleanupStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/local_flow_surface"
            android:padding="16dp"
            android:text="@string/status_cleanup_model_not_loaded"
            android:textColor="@color/local_flow_text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/loadCleanupModelButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/load_cleanup_model" />

        <Button
            android:id="@+id/cleanTextButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/clean_text" />

        <Button
            android:id="@+id/runCleanupEvalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/run_cleanup_evaluation" />

        <TextView
            android:id="@+id/evaluationStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_evaluation_idle"
            android:textColor="@color/local_flow_muted"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/cleanup_model_input"
            android:textColor="@color/local_flow_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cleanupModelInputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/local_flow_surface"
            android:gravity="top|start"
            android:minHeight="80dp"
            android:padding="16dp"
            android:text="@string/cleanup_model_input_placeholder"
            android:textColor="@color/local_flow_muted"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/raw_model_output"
            android:textColor="@color/local_flow_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modelOutputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/local_flow_surface"
            android:gravity="top|start"
            android:minHeight="100dp"
            android:padding="16dp"
            android:text="@string/model_output_placeholder"
            android:textColor="@color/local_flow_muted"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/cleaned_transcript"
            android:textColor="@color/local_flow_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cleanedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/local_flow_surface"
            android:gravity="top|start"
            android:minHeight="120dp"
            android:padding="16dp"
            android:text="@string/cleaned_transcript_placeholder"
            android:textColor="@color/local_flow_text"
            android:textIsSelectable="true"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/latency_metrics"
            android:textColor="@color/local_flow_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/metricsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/local_flow_surface"
            android:fontFamily="monospace"
            android:minHeight="96dp"
            android:padding="16dp"
            android:text="@string/metrics_placeholder"
            android:textColor="@color/local_flow_muted"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
