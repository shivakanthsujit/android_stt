<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/benchmark_title"
            android:textColor="@color/local_flow_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/benchmark_subtitle"
            android:textColor="@color/local_flow_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/local_flow_surface"
            android:padding="16dp"
            android:text="@string/status_model_not_loaded"
            android:textColor="@color/local_flow_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/loadModelButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/load_model" />

        <Button
            android:id="@+id/dictationButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/start_dictation"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/raw_transcript"
            android:textColor="@color/local_flow_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/transcriptText"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            android:background="@color/local_flow_surface"
            android:gravity="top|start"
            android:padding="16dp"
            android:text="@string/transcript_placeholder"
            android:textColor="@color/local_flow_text"
            android:textIsSelectable="true"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/latency_metrics"
            android:textColor="@color/local_flow_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/metricsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/local_flow_surface"
            android:fontFamily="monospace"
            android:minHeight="96dp"
            android:padding="16dp"
            android:text="@string/metrics_placeholder"
            android:textColor="@color/local_flow_muted"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
