<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/local_flow_background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/imeStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/ime_status_models_needed"
        android:textColor="@color/local_flow_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/ime_integration_warning"
        android:textColor="@color/local_flow_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/imeDetailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="4"
        android:textColor="@color/local_flow_muted"
        android:textSize="13sp" />

    <Button
        android:id="@+id/imeMainButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/ime_main_action_description"
        android:text="@string/ime_load_models"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/imeCancelButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/ime_cancel" />

        <Button
            android:id="@+id/imeUndoButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/ime_undo" />

        <Button
            android:id="@+id/imeNextKeyboardButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/ime_next_keyboard" />
    </LinearLayout>

    <TextView
        android:id="@+id/imeMetricsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/local_flow_muted"
        android:textSize="11sp" />
</LinearLayout>
